# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only: comma-separated hosts for Next allowedDevOrigins (LAN IP for phone testing)
# ALLOWED_DEV_ORIGINS=192.168.0.105

# MAX Bot (https://business.max.ru)
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=moyazapis_bot
MAX_WEBHOOK_URL=https://your-domain.com/api/max/webhook
MAX_WEBHOOK_SECRET=your-secret-min-5-chars

# Admin key for webhook setup (POST /api/max/setup)
ADMIN_SETUP_KEY=change-me

# VK Group token with messages permission
VK_GROUP_TOKEN=
VK_CALLBACK_CONFIRMATION=

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=moyazapis_bot
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-secret-8-to-256-chars

# Outbox flush (POST /api/cron/flush)
CRON_SECRET=change-me

# Email notifications (F28) — Mail.ru example
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@mail.ru
# SMTP_PASS=
# SMTP_FROM=МояЗапись <noreply@mail.ru>
# Email владельцу SaaS об истекающих подписках (F34); иначе SMTP_USER
# ADMIN_NOTIFY_EMAIL=you@mail.ru
# OWNER_ALERT_WARN_DAYS=3

# Billing / ЮKassa (F31) + пилот по переводу
# BILLING_MODE=transfer
# BILLING_TRANSFER_PHONE=+79001234567
# BILLING_TRANSFER_BANK=Сбер / Тинькофф
# BILLING_TRANSFER_NAME=Иван И.
# BILLING_SUPPORT_CONTACT=moyazapis@mail.ru
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BILLING_LITE_PRICE_RUB=149
# BILLING_BASIC_PRICE_RUB=290
# BILLING_PRO_PRICE_RUB=590

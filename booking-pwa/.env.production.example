# Production env for docker compose / VPS
# Copy to .env.production and fill in real values.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.ru

# MAX Bot — https://business.max.ru
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=moyazapis_bot
MAX_WEBHOOK_URL=https://your-domain.ru/api/max/webhook
MAX_WEBHOOK_SECRET=change-me-to-long-random-secret

# Admin key for POST /api/max/setup
ADMIN_SETUP_KEY=change-me-admin-key

# VK (optional)
VK_GROUP_TOKEN=
VK_CALLBACK_CONFIRMATION=

# Telegram Bot (optional channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=moyazapis_bot
TELEGRAM_WEBHOOK_URL=https://myazapis.ru/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-secret

# Cron / outbox flush
CRON_SECRET=change-me-cron-secret

# Email (Mail.ru SMTP) — optional until F28 enabled
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=МояЗапись <noreply@mail.ru>
# ADMIN_NOTIFY_EMAIL=
# OWNER_ALERT_WARN_DAYS=3

# Billing / ЮKassa (F31)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# BILLING_BASIC_PRICE_RUB=290
# BILLING_PRO_PRICE_RUB=590
# BILLING_PERIOD_DAYS=30
# BILLING_MOCK=0
# BACKUP_KEEP=14

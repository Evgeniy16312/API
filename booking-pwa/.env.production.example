# Production env for docker compose / VPS
# Copy to .env.production and fill in real values.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.ru

# MAX Bot — https://business.max.ru
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=moyazapis_bot
MAX_WEBHOOK_URL=https://your-domain.ru/api/max/webhook
MAX_WEBHOOK_SECRET=change-me-to-long-random-secret

# Admin key for POST /api/max/setup
ADMIN_SETUP_KEY=change-me-admin-key

# VK (optional)
VK_GROUP_TOKEN=
VK_CALLBACK_CONFIRMATION=

# Cron / outbox flush
CRON_SECRET=change-me-cron-secret
